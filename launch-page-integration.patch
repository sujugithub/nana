+    def _send_launch(self, path: str) -> None:
+        """Serve /launch and the files under static/launch, refusing path escapes."""
+        if path == "/launch":
+            self._send_static("launch.html", "text/html; charset=utf-8")
+            return
+        if path == "/launch/":
+            # The page uses relative asset URLs, which resolve from /launch.
+            self.send_response(301)
+            self.send_header("Location", "/launch")
+            self.end_headers()
+            return
+        root = os.path.realpath(os.path.join(_STATIC_DIR, "launch"))
+        target = os.path.realpath(os.path.join(root, path[len("/launch/"):]))
+        if os.path.isdir(target) and target.startswith(root + os.sep):
+            if not path.endswith("/"):
+                # Relative asset URLs inside the folder need the trailing slash.
+                self.send_response(301)
+                self.send_header("Location", path + "/")
+                self.end_headers()
+                return
+            target = os.path.join(target, "index.html")
+        kind = _LAUNCH_TYPES.get(os.path.splitext(target)[1].lower())
+        if not target.startswith(root + os.sep) or kind is None or not os.path.isfile(target):
+            self._send_json({"error": "Not found"}, 404)
+            return
+        self._send_static(os.path.relpath(target, _STATIC_DIR), kind)
