+    def test_launch_page_and_game_served(self):
+        base = f"http://127.0.0.1:{self.port}"
+        with urllib.request.urlopen(f"{base}/launch") as res:
+            body = res.read().decode()
+        self.assertIn("Nana", body)
+        self.assertIn('"launch/games/reef-rally/"', body)
+        with urllib.request.urlopen(f"{base}/launch/games/reef-rally/") as res:
+            self.assertTrue(res.headers["Content-Type"].startswith("text/html"))
+            assets = re.findall(r'src="\./(assets/[^"]+\.js)"', res.read().decode())
+        self.assertTrue(assets)
+        with urllib.request.urlopen(f"{base}/launch/games/reef-rally/{assets[0]}") as res:
+            self.assertTrue(res.headers["Content-Type"].startswith("text/javascript"))
+
+    def test_launch_folder_redirects_and_escapes_rejected(self):
+        base = f"http://127.0.0.1:{self.port}"
+        with urllib.request.urlopen(f"{base}/launch/games/reef-rally") as res:
+            self.assertTrue(res.url.endswith("/launch/games/reef-rally/"))
+        with urllib.request.urlopen(f"{base}/launch/") as res:
+            self.assertTrue(res.url.endswith("/launch"))
+        for path in ("/launch/../server.py", "/launch/%2e%2e/chat.html",
+                     "/launch/games/../../launch.html", "/launch/missing.js"):
+            with self.assertRaises(urllib.error.HTTPError) as caught:
+                urllib.request.urlopen(base + path)
+            self.assertEqual(caught.exception.code, 404, path)
