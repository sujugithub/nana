# Copy to .env and fill in. main.py does NOT auto-load .env — export the
# variables in your shell, or pass the file to Docker:
#   docker run --rm --env-file .env hybrid-router-agent

FIREWORKS_API_KEY=fw-xxxxxxxxxxxxxxxx

# Select the deployment being demonstrated (local_remote is the safe default):
#   remote_pair  = Nemotron Lightning (cheap) -> gpt-oss-120b (strong)
#   local_remote = local Qwen (cheap) -> gpt-oss-120b (strong)
TIER_MODE=local_remote

# Injected by the runtime environment (set locally for development):
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1  # ALL remote calls go through it
# ALLOWED_MODELS=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b,accounts/fireworks/models/gpt-oss-120b
# REMOTE_MODEL_PREFERENCE=gpt-oss-120b   # tie-breaker within ALLOWED_MODELS
# RUN_DEADLINE_S=540        # stop waiting + write results this many s after start
# REMOTE_CONCURRENCY=8      # parallel remote calls in the task pool

# Overrides (defaults live in config.py):
# LOCAL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# CHEAP_MODEL_NAME=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
# STRONG_MODEL_NAME=accounts/fireworks/models/gpt-oss-120b
# CHEAP_MAX_TOKENS=1024
# STRONG_MAX_TOKENS=4096
# CHEAP_INPUT_PER_MTOK=0.05     # published serverless rates; verify before quoting spend
# CHEAP_OUTPUT_PER_MTOK=0.20
# STRONG_INPUT_PER_MTOK=0.15
# STRONG_OUTPUT_PER_MTOK=0.60
# CONFIDENCE_THRESHOLD=0.55
# LOGPROB_CONFIDENCE_THRESHOLD=0.4   # local model's self-confidence gate; 0 disables
# LOCAL_CONF_STAT=mean      # gate statistic: mean | min | low_frac | none
# ROUTER_MODE=heuristic     # heuristic | learned | auto (see docs/LEARNED_ROUTING.md)
# ROUTER_ARTIFACT=artifacts/router_qwen_pro_600.joblib  # trusted pair-specific artifact
# ENABLE_ESCALATION=1
# LOCAL_MAX_NEW_TOKENS=512
# REQUEST_TIMEOUT_S=120     # read timeout; must cover a full remote generation
# CONNECT_TIMEOUT_S=10
# AGENT_MOCK=1

# Persistent chat (make ui serves /chat on localhost):
# NANA_CHAT_DB=/absolute/path/to/nana-chat.db
# NANA_API_TOKEN=choose-a-long-random-token  # needed when exposing FastAPI beyond localhost
# NANA_CHAT_ALLOW_REAL=1               # FastAPI only; make ui-real uses --real
